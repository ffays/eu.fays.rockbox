									<target>
										<echo>Profile: profile-windows-x86_64</echo>
										<unjar src="${project.build.directory}/dependency/ortools-win32-x86-64-${or-tools.version}.jar" dest="${project.build.directory}" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
<description><![CDATA[

# Powershell only
$env:MAVEN_OPTS="-Djava.library.path=target\ortools-win32-x86-64"

mvn clean dependency:copy-dependencies package

mvn exec:java@ORToolsEssay

]]></description>
</project>