	<build>
		<plugins>
			<!-- https://mvnrepository.com/artifact/org.codehaus.mojo/exec-maven-plugin -->
			<!-- https://www.mojohaus.org/exec-maven-plugin/usage.html -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${exec-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>ORToolsEssay</id>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>eu.fays.rockbox.ortools.ORToolsEssay</mainClass>
							<systemProperties>
								<systemProperty>
									<key>java.util.logging.SimpleFormatter.format</key>
									<value>%5$s%6$s%n</value>
								</systemProperty>
								<systemProperty>
									<key>java.library.path</key>
									<value>target/ortools-win32-x86-64</value>
								</systemProperty>
							</systemProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	
	<!-- 
		Unziping the OR-Tools libraries from the jar file is NOT required,
		because the method Loader.loadNativeLibraries() unzip them in a temporary folder,
		before loading them.
	-->
	<profiles>
		<profile>
			<id>profile-linux-x86_64</id>
			<activation>
				<os>
					<name>Linux</name>
					<arch>amd64</arch>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${maven-antrun-plugin.version}</version>
						<executions>
							<execution>
								<id>maven-antrun-linux-x86_64</id>
								<phase>validate</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<echo>Profile: profile-linux-x86_64</echo>
										<unjar src="${project.build.directory}/dependency/ortools-linux-x86-64-${or-tools.version}.jar" dest="${project.build.directory}" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>profile-linux-aarch64</id>
			<activation>
				<os>
					<name>Linux</name>
					<arch>aarch64</arch>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${maven-antrun-plugin.version}</version>
						<executions>
							<execution>
								<id>maven-antrun-linux-aarch64</id>
								<phase>validate</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<echo>Profile: profile-linux-aarch64</echo>
										<unjar src="${project.build.directory}/dependency/ortools-linux-aarch64-${or-tools.version}.jar" dest="${project.build.directory}" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>profile-macosx-x86_64</id>
			<activation>
				<os>
					<name>Mac OS X</name>
					<arch>amd64</arch>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${maven-antrun-plugin.version}</version>
						<executions>
							<execution>
								<id>maven-antrun-macosx-x86_64</id>
								<phase>validate</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<echo>Profile: profile-macosx-x86_64</echo>
										<unjar src="${project.build.directory}/dependency/ortools-darwin-x86-64-${or-tools.version}.jar" dest="${project.build.directory}" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>profile-macosx-aarch64</id>
			<activation>
				<os>
					<name>Mac OS X</name>
					<arch>aarch64</arch>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${maven-antrun-plugin.version}</version>
						<executions>
							<execution>
								<id>maven-antrun-macosx-aarch64</id>
								<phase>validate</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<echo>Profile: profile-macosx-aarch64</echo>
										<unjar src="${project.build.directory}/dependency/ortools-darwin-aarch64-${or-tools.version}.jar" dest="${project.build.directory}" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>profile-windows-x86_64</id>
			<activation>
				<os>
					<family>Windows</family>
					<arch>amd64</arch>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${maven-antrun-plugin.version}</version>
						<executions>
							<execution>
								<id>maven-antrun-windows-x86_64</id>
								<phase>validate</phase>
								<goals>
									<goal>run</goal>
